# ~/.config/mediaserver/env (chmod 600)
# Loaded by deploy/local/start-server.sh.
MUSIC_ROOT=/srv/media/music
MEDIA_VIDEO_ROOT=/srv/media/videos
MEDIA_IMAGE_ROOT=/srv/media/images
MEDIA_DOC_ROOT=/srv/media/docs
MEDIA_DATA_DIR=/var/lib/mediaserver
MEDIA_HOST=127.0.0.1
MEDIA_PORT=8080
MEDIA_AUTH_MODE=token
MEDIA_TOKEN=replace-with-a-long-random-token
MEDIA_TRUST_PROXY=1
MEDIA_COOKIE_SECURE=1
MEDIA_PUBLIC_URL=https://media.example.com:8443
MEDIA_LOG_LEVEL=INFO
