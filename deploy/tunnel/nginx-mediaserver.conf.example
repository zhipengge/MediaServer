# /etc/nginx/sites-available/mediaserver
#
# __DOMAIN__ and __HTTPS_PORT__ are substituted by setup-vps.sh.
# Port 80 is only used for ACME HTTP-01 and a redirect.
# The upstream is an SSH reverse tunnel bound to 127.0.0.1 on the VPS.

limit_req_zone $binary_remote_addr zone=mediaserver_login:10m rate=5r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host:__HTTPS_PORT__$request_uri;
    }
}

server {
    listen __HTTPS_PORT__ ssl http2;
    listen [::]:__HTTPS_PORT__ ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    server_tokens off;

    # Uploads and shares can be large; match MEDIA_UPLOAD_MAX_MB.
    client_max_body_size 1g;
    client_body_timeout 300s;

    # Optional second factor at the proxy layer:
    #   htpasswd -c /etc/nginx/mediaserver.htpasswd viewer
    # auth_basic "MediaServer";
    # auth_basic_user_file /etc/nginx/mediaserver.htpasswd;

    location = /login {
        limit_req zone=mediaserver_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:18080;
        include /etc/nginx/mediaserver-proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:18080;
        include /etc/nginx/mediaserver-proxy.conf;
    }
}
