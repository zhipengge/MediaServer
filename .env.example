# Copy to .env for local development. Never commit real tokens or LAN addresses.
# Docker users can put the same keys in a compose .env file.

# ── storage ───────────────────────────────────────────────────────
# Read-only media library. NAS-DEPLOY uses MUSIC_ROOT=/music.
# Layout: $MUSIC_ROOT (music), and optionally $MEDIA_LIBRARY_ROOT/{videos,images,docs}.
MUSIC_ROOT=./media/music
MEDIA_DATA_DIR=./data

# ── network ───────────────────────────────────────────────────────
MEDIA_HOST=127.0.0.1
MEDIA_PORT=8080
# Absolute base used in manifests behind a reverse proxy.
# MEDIA_PUBLIC_URL=https://media.example.com
# Set to 1 only when a trusted reverse proxy sets X-Forwarded-* headers.
MEDIA_TRUST_PROXY=0

# ── security ──────────────────────────────────────────────────────
# off  = trusted LAN only (NAS-DEPLOY default)
# token = required for anything reachable from the internet
MEDIA_AUTH_MODE=off
# At least 16 characters; generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# MEDIA_TOKEN=
# Persist sessions across restarts; otherwise generated in DATA_DIR/.secret.
# MEDIA_SECRET_KEY=
MEDIA_COOKIE_SECURE=0
# Exact origin, e.g. https://web.example.com (empty = no CORS headers)
MEDIA_CORS_ORIGIN=

# ── limits ────────────────────────────────────────────────────────
MEDIA_SHARE_MAX_MB=300
MEDIA_UPLOAD_MAX_MB=1024

# ── scanning / cache ──────────────────────────────────────────────
MEDIA_SCAN_ON_START=1
MEDIA_SCAN_INTERVAL=300
MEDIA_THUMB_CACHE_MB=512

# ── video / HLS ───────────────────────────────────────────────────
MEDIA_HLS_ENABLED=1
MEDIA_HLS_HEIGHT=720
MEDIA_HLS_SEGMENT=6
MEDIA_HLS_CACHE_MB=8192
MEDIA_HLS_CONCURRENCY=2
# Optional explicit binaries; otherwise ffmpeg/ffprobe on PATH are used.
# MEDIA_FFMPEG=/usr/bin/ffmpeg
# MEDIA_FFPROBE=/usr/bin/ffprobe

# ── optional Meting relay (off by default) ────────────────────────
MEDIA_RELAY_ENABLED=0
# MEDIA_RELAY_BASE=https://api.example.com/meting/
MEDIA_RELAY_TIMEOUT=20
MEDIA_RELAY_ALLOW_PRIVATE=0

MEDIA_LOG_LEVEL=INFO
